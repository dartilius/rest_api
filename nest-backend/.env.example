# The role must have SELECT only on source tables. Do not reuse Django credentials.
SOURCE_DB_HOST=192.168.0.8
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=rest_api
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=postgres
# The current source data lives in Django's public schema. The website schema
# is reserved for later read-model and site-owned entities.
SOURCE_DB_SCHEMA=public
WEBSITE_DB_SCHEMA=website
PORT=3001

# Public browser-reachable MinIO endpoint. The key must have only s3:GetObject
# on local-media/* and must not reuse the Django/MinIO administrator key.
MINIO_ENDPOINT=192.168.0.8
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=nest-read-only
MINIO_SECRET_KEY=change-me
MINIO_MEDIA_BUCKET=local-media
MINIO_PRESIGNED_URL_TTL_SECONDS=900

# Comma-separated browser origins. Leave blank when the site uses the same origin.
CORS_ORIGINS=https://krasrm.com

# Django is the only JWT issuer. Nest receives only its RS256 public key.
JWT_PUBLIC_KEY_PATH=C:/secure/rmc-jwt/public.pem
JWT_ISSUER=rmc-django
JWT_AUDIENCE=rmc-site-api
# Keep these two values only until the announced migration deadline. The secret
# must be the former Django SECRET_KEY; never use the new RSA private key here.
JWT_LEGACY_HS256_SECRET=
JWT_LEGACY_HS256_ACCEPT_UNTIL=2026-10-01T00:00:00Z
